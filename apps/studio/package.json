{
  "name": "matchcut-studio",
  "private": true,
  "type": "module",
  "description": "Matchcut Studio: the 3D show camera, bundled for a strict same-origin CSP",
  "scripts": {
    "assets": "node scripts/assets.mjs",
    "build": "esbuild src/show3d/main.js --bundle --format=esm --target=es2022 --minify --sourcemap --legal-comments=linked --outfile=dist/show3d.js",
    "check": "node --check src/show3d/main.js"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "esbuild": "0.28.2",
    "meshoptimizer": "1.3.0"
  }
}
