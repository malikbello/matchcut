{
  "$id": "https://matchcut.dev/schemas/1.3.0/truth-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What really happened tactically. Hidden from every downstream service; used only to score them.",
  "properties": {
    "detail": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "string"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "title": "Detail",
      "type": "object"
    },
    "kind": {
      "enum": [
        "tactic_change",
        "storyline",
        "fatigue",
        "shot_probability"
      ],
      "title": "Kind",
      "type": "string"
    },
    "match_id": {
      "title": "Match Id",
      "type": "string"
    },
    "player_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Player Id"
    },
    "schema_version": {
      "default": "1.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "t_ms": {
      "minimum": 0,
      "title": "T Ms",
      "type": "integer"
    },
    "team_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Team Id"
    }
  },
  "required": [
    "match_id",
    "t_ms",
    "kind",
    "detail"
  ],
  "title": "TruthRecord",
  "type": "object"
}
