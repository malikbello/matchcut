{
  "$defs": {
    "BodyPart": {
      "enum": [
        "left_foot",
        "right_foot",
        "head"
      ],
      "title": "BodyPart",
      "type": "string"
    },
    "EventType": {
      "enum": [
        "kick_off",
        "pass",
        "carry",
        "shot",
        "save",
        "goal",
        "block",
        "tackle",
        "interception",
        "clearance",
        "pressure",
        "ball_recovery",
        "possession_change",
        "foul",
        "card",
        "throw_in",
        "corner",
        "goal_kick",
        "free_kick",
        "substitution",
        "period_start",
        "period_end"
      ],
      "title": "EventType",
      "type": "string"
    },
    "Outcome": {
      "enum": [
        "success",
        "fail"
      ],
      "title": "Outcome",
      "type": "string"
    }
  },
  "$id": "https://matchcut.dev/schemas/1.2.0/match-event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attacking_right": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "True when team_id attacks +x",
      "title": "Attacking Right"
    },
    "ball_speed_kmh": {
      "anyOf": [
        {
          "maximum": 160,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ball Speed Kmh"
    },
    "body_part": {
      "anyOf": [
        {
          "$ref": "#/$defs/BodyPart"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "clock": {
      "description": "Broadcast clock, e.g. 45:00+2",
      "pattern": "^\\d{1,3}:\\d{2}(\\+\\d{1,2})?$",
      "title": "Clock",
      "type": "string"
    },
    "detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Small qualifier: yellow/red for cards, on/off for substitution, set-piece type",
      "title": "Detail"
    },
    "end_x": {
      "anyOf": [
        {
          "maximum": 105,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End X"
    },
    "end_y": {
      "anyOf": [
        {
          "maximum": 68,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End Y"
    },
    "event_id": {
      "pattern": "^EV-\\d{5}$",
      "title": "Event Id",
      "type": "string"
    },
    "match_id": {
      "title": "Match Id",
      "type": "string"
    },
    "outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/Outcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "period": {
      "enum": [
        1,
        2
      ],
      "title": "Period",
      "type": "integer"
    },
    "player_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Player Id"
    },
    "recipient_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Pass target or player fouled",
      "title": "Recipient Id"
    },
    "related_event_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Related Event Id"
    },
    "schema_version": {
      "default": "1.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seq": {
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "t_ms": {
      "description": "Milliseconds since kick-off on one continuous timeline",
      "minimum": 0,
      "title": "T Ms",
      "type": "integer"
    },
    "team_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Team Id"
    },
    "type": {
      "$ref": "#/$defs/EventType"
    },
    "under_pressure": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Under Pressure"
    },
    "x": {
      "anyOf": [
        {
          "maximum": 105,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "X"
    },
    "y": {
      "anyOf": [
        {
          "maximum": 68,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Y"
    }
  },
  "required": [
    "match_id",
    "event_id",
    "seq",
    "period",
    "t_ms",
    "clock",
    "type"
  ],
  "title": "MatchEvent",
  "type": "object"
}
