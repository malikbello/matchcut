{
  "$defs": {
    "MomentKind": {
      "enum": [
        "goal",
        "big_chance",
        "great_save",
        "momentum_swing",
        "press_surge",
        "tactical_shift",
        "speed_peak",
        "card",
        "substitution"
      ],
      "title": "MomentKind",
      "type": "string"
    }
  },
  "$id": "https://matchcut.dev/schemas/1.1.0/moment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Something worth showing on screen, found by code (never by a model).",
  "properties": {
    "clock": {
      "title": "Clock",
      "type": "string"
    },
    "evidence_event_ids": {
      "description": "Events that prove the moment",
      "items": {
        "type": "string"
      },
      "title": "Evidence Event Ids",
      "type": "array"
    },
    "importance": {
      "description": "Editorial weight used to rank moments for overlays and recaps",
      "maximum": 1,
      "minimum": 0,
      "title": "Importance",
      "type": "number"
    },
    "kind": {
      "$ref": "#/$defs/MomentKind"
    },
    "match_id": {
      "title": "Match Id",
      "type": "string"
    },
    "metrics": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ]
      },
      "description": "Code-computed numbers agents may cite, at the precision given",
      "title": "Metrics",
      "type": "object"
    },
    "moment_id": {
      "pattern": "^MO-\\d{5}$",
      "title": "Moment Id",
      "type": "string"
    },
    "player_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Player Id"
    },
    "schema_version": {
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "t_ms": {
      "minimum": 0,
      "title": "T Ms",
      "type": "integer"
    },
    "team_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Team Id"
    }
  },
  "required": [
    "match_id",
    "moment_id",
    "t_ms",
    "clock",
    "kind",
    "importance"
  ],
  "title": "Moment",
  "type": "object"
}
