{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Matchcut design tokens v1. Source of truth for web, broadcast graphics and rendered films. See docs/brand/brand-system.md.",
  "color": {
    "ink": {
      "950": { "$value": "#07090D", "$type": "color", "$description": "Canvas" },
      "900": { "$value": "#0C1016", "$type": "color", "$description": "App background" },
      "800": { "$value": "#141A22", "$type": "color", "$description": "Surfaces, cards" },
      "700": { "$value": "#212A35", "$type": "color", "$description": "Lines, dividers" }
    },
    "chalk": { "$value": "#F4F6F9", "$type": "color", "$description": "Primary text" },
    "mist": { "$value": "#9AA6B5", "$type": "color", "$description": "Secondary text" },
    "signal": { "$value": "#FF4A2E", "$type": "color", "$description": "Brand accent: live, the cut, primary actions" },
    "verified": { "$value": "#2DE3A0", "$type": "color", "$description": "Only for content checked against data" },
    "floodlight": { "$value": "#FFB547", "$type": "color", "$description": "Pending, checking, warnings" },
    "data": { "$value": "#6CC8FF", "$type": "color", "$description": "Analytics lines and charts" },
    "turf": {
      "900": { "$value": "#0B2E23", "$type": "color", "$description": "Pitch, dark" },
      "600": { "$value": "#1B6A4C", "$type": "color", "$description": "Pitch, light" }
    },
    "light": {
      "canvas": { "$value": "#F6F7F9", "$type": "color", "$description": "Document canvas" },
      "surface": { "$value": "#FFFFFF", "$type": "color" },
      "ink": { "$value": "#0C1016", "$type": "color" },
      "line": { "$value": "#E3E7EC", "$type": "color" }
    }
  },
  "font": {
    "display": { "$value": "'Big Shoulders Display', 'Arial Narrow', sans-serif", "$type": "fontFamily", "$description": "Scores, headlines, big numbers" },
    "ui": { "$value": "Inter, 'Segoe UI', system-ui, sans-serif", "$type": "fontFamily", "$description": "Interface and body, tabular figures" },
    "mono": { "$value": "'JetBrains Mono', ui-monospace, monospace", "$type": "fontFamily", "$description": "Clock, timecode, evidence IDs" },
    "arabic": { "$value": "'IBM Plex Sans Arabic', 'Segoe UI', sans-serif", "$type": "fontFamily" },
    "devanagari": { "$value": "'Noto Sans Devanagari', 'Segoe UI', sans-serif", "$type": "fontFamily" }
  },
  "size": {
    "type": { "xs": 12, "sm": 14, "md": 16, "lg": 20, "xl": 28, "2xl": 40, "3xl": 64, "4xl": 96 },
    "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64 },
    "radius": { "chip": 6, "card": 14, "panel": 18, "pill": 999 }
  },
  "motion": {
    "cutIn": { "$value": { "duration": "160ms", "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)", "distance": "12px" }, "$description": "Graphics enter: clip wipe + slide" },
    "cutOut": { "$value": { "duration": "120ms", "easing": "cubic-bezier(0.4, 0, 1, 1)" } },
    "verifiedSweep": { "$value": { "duration": "240ms", "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)" } },
    "reducedMotion": { "$value": "opacity-only fades, 120ms" }
  },
  "rules": {
    "$description": "One accent per view. Verified mint is never decorative. Colour is always paired with an icon or label. Text contrast >= 4.5:1."
  }
}
